{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kpi-executive-manufacturing",
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-18",
  "keep_vars": true,
  "observability": {
    "enabled": true
  },
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "vars": {
    "APP_NAME": "Executive KPI Manufacturing Control Center",
    "COMPANY_NAME": "PT BANSHU ELECTRIC INDONESIA",
    "APP_VERSION": "2.2.3",
    "APP_ENV": "production"
  }
}
